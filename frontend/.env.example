# Modo local de demostración: npm run dev usa .env.development
# Para probar Supabase localmente, VITE_DEMO_MODE=false en .env.development.local
VITE_DEMO_MODE=false
VITE_SUPABASE_URL=https://TU_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICABLE
# Nunca usar service_role ni claves secretas en VITE_*.
# Opcional: URL HTTPS del microservicio de IA. En desarrollo se intenta localhost:8000.
VITE_AI_SERVICE_URL=
